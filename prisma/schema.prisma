generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        Int            @id @default(autoincrement())
  username  String?        @unique
  email     String         @unique
  phone     String?        @unique
  password  String
  role      Role           @default(CLIENT)
  createdAt DateTime       @default(now())
  vendor    VendorProfile?
  otpCodes  OtpCode[]

  cart      Cart?
  orders    Order[]
  addresses Address[]

  loyaltyWallet LoyaltyWallet?
  loyaltyEntries LoyaltyEntry[]
  couponUsages   CouponUsage[]

  referralsSent     Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referee")
}

model VendorProfile {
  id         Int           @id @default(autoincrement())
  user       User          @relation(fields: [userId], references: [id])
  userId     Int           @unique
  codeUnique String?       @unique
  status     VendorStatus  @default(PENDING)
  kycDocs    KycDocument[]
  createdAt  DateTime      @default(now())
  products   Product[] // Ajouté: relation avec Product
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model KycDocument {
  id              Int           @id @default(autoincrement())
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  vendorProfileId Int
  type            String
  url             String
  status          String        @default("PENDING")
  uploadedAt      DateTime      @default(now())
}

model Product {
  id          Int            @id @default(autoincrement())
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])
  vendorId    Int?
  category    Category?      @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  title       String
  description String?
  createdAt   DateTime       @default(now())

  variants ProductVariant[]

  media Media[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  name  String
  price Float
  stock Int

  createdAt DateTime @default(now())

  CartItem  CartItem[]
  OrderItem OrderItem[]
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  type      String // IMAGE (prévu pour extension future)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
}

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int        @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id             Int            @id @default(autoincrement())
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId         Int
  productVariant ProductVariant @relation(fields: [variantId], references: [id])
  variantId      Int
  quantity       Int
  unitPrice      Float // prix figé
  createdAt      DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Address {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  fullName    String
  phone       String
  addressLine String
  city        String
  country     String
  createdAt   DateTime @default(now())
  Order       Order[]
}

model Order {
  id          Int         @id @default(autoincrement())
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  address     Address     @relation(fields: [addressId], references: [id])
  addressId   Int
  status      OrderStatus @default(PENDING)
  totalAmount Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  payment     Payment?
  shipment    Shipment?
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId Int

  name      String // snapshot du nom
  unitPrice Float // snapshot du prix
  quantity  Int
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  ORANGE_MONEY
  MTN_MOMO
}

enum PaymentType {
  FULL
  DEPOSIT
}


model Payment {
  id            Int           @id @default(autoincrement())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       Int           @unique

  method        PaymentMethod
  type          PaymentType   @default(FULL)
  amount        Float         // montant payé (100% ou 20%)
  status        PaymentStatus @default(PENDING)

  attempts      PaymentAttempt[]
  createdAt     DateTime      @default(now())
}


model PaymentAttempt {
  id          Int           @id @default(autoincrement())
  payment     Payment       @relation(fields: [paymentId], references: [id])
  paymentId   Int

  providerRef String?       // ID Orange / MTN
  status      PaymentStatus
  response    Json?
  createdAt   DateTime      @default(now())
}

model TransactionLog {
  id        Int      @id @default(autoincrement())
  type      String   // INIT, CALLBACK, ERROR
  payload   Json
  createdAt DateTime @default(now())
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model Shipment {
  id        Int            @id @default(autoincrement())
  order     Order          @relation(fields: [orderId], references: [id])
  orderId   Int            @unique
  status    ShipmentStatus @default(CREATED)
  events    TrackingEvent[]
  createdAt DateTime       @default(now())
}

model TrackingEvent {
  id          Int      @id @default(autoincrement())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  Int
  label       String
  createdAt   DateTime @default(now())
}

enum LoyaltyEntryType {
  EARN
  SPEND
}

enum LoyaltySource {
  ORDER
  COUPON
  REFERRAL
  SIGNUP
  ADMIN
}

enum CouponType {
  FIXED
  PERCENTAGE
}

model LoyaltyWallet {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique

  balance   Int      @default(0)

  entries   LoyaltyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoyaltyEntry {
  id        Int              @id @default(autoincrement())

  wallet    LoyaltyWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId  Int

  user      User             @relation(fields: [userId], references: [id])
  userId    Int

  type      LoyaltyEntryType
  source    LoyaltySource

  points    Int
  reference String?          // ex: ORDER_12, COUPON_XYZ

  createdAt DateTime         @default(now())
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique

  type        CouponType
  value       Float      // montant ou pourcentage

  maxUses     Int?
  usedCount   Int        @default(0)

  expiresAt   DateTime?
  isActive    Boolean    @default(true)

  usages      CouponUsage[]

  createdAt   DateTime   @default(now())
}

model CouponUsage {
  id        Int      @id @default(autoincrement())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponId  Int

  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  usedAt    DateTime @default(now())

  @@unique([couponId, userId])
}

model Referral {
  id          Int      @id @default(autoincrement())

  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
  referrerId  Int

  referee     User     @relation("Referee", fields: [refereeId], references: [id])
  refereeId   Int

  rewardGiven Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([referrerId, refereeId])
}


